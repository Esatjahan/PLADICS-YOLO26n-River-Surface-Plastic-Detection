    "disp": true,
    "width": "12",
    "collapse": false
  },
  {
    "id": "mqtt_broker",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "pladics_dashboard",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "mqtt_in",
    "type": "mqtt in",
    "z": "tab_pladics",
    "name": "PLADICS Live MQTT",
    "topic": "pladics/live",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 150,
    "y": 100,
    "wires": [
      [
        "fn_split"
      ]
    ]
  },
  {
    "id": "fn_split",
    "type": "function",
    "z": "tab_pladics",
    "name": "Split telemetry",
    "func": "\nlet p = msg.payload;\n\nreturn [\n    {payload: p.plastic_count},\n    {payload: Number(p.confidence)},\n    {payload: Number(p.fps)},\n    {payload: Number(p.inference_ms)},\n    {payload: p.mission_state},\n    {payload: p.action},\n    {payload: p.conveyor_state},\n    {payload: p.obstacle_detected},\n    {payload: Number(p.cpu_usage_percent)},\n    {payload: Number(p.ram_usage_percent)},\n    {payload: Number(p.cpu_temperature)},\n    {payload: p.collection_count},\n    {payload: p.frame}\n];\n",
    "outputs": 13,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 100,
    "wires": [
      [
        "txt_plastic",
        "chart_detection"
      ],
      [
        "gauge_conf",
        "chart_conf"
      ],
      [
        "gauge_fps",
        "chart_fps"
      ],
      [
        "gauge_inf",
        "chart_inf"
      ],
      [
        "txt_state"
      ],
      [
        "txt_action"
      ],
      [
        "txt_conveyor"
      ],
      [
        "txt_obstacle"
      ],
      [
        "gauge_cpu"
      ],
      [
        "gauge_ram"
      ],
      [
        "gauge_temp"
      ],
      [
        "txt_collection"
      ],
      [
        "txt_frame"
      ]
    ]
  },
